# Copy to /srv/zento/.env on the server and fill in
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
ZENTO_PAYMENT_PROVIDER=mock
# Keep data outside the git checkout so deploys never touch it
ZENTO_DB_PATH=/srv/zento-data/db.sqlite3
ZENTO_MEDIA_ROOT=/srv/zento-data/media
